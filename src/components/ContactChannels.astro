---
/** Canales de contacto. Todos los datos provienen de src/config/site.ts */
import Icon from './Icon.astro';
import Pending from './Pending.astro';
import type { Name } from './icon-names';
import { site, whatsappUrl } from '../config/site';

const c = site.contact;
const wa = whatsappUrl();

const channels: { icon: Name; label: string; value: string | null; href: string | null; external?: boolean; note: string }[] = [
  { icon: 'whatsapp', label: 'WhatsApp', value: c.whatsappDisplay ?? (c.whatsapp ? 'Enviar mensaje' : null), href: wa, external: true, note: 'La vía más rápida para una primera orientación.' },
  { icon: 'phone', label: 'Teléfono', value: c.phoneDisplay ?? c.phone, href: c.phone ? `tel:${c.phone}` : null, note: 'Llámanos en horario de atención.' },
  { icon: 'mail', label: 'Correo electrónico', value: c.email, href: c.email ? `mailto:${c.email}` : null, note: 'Para enviar documentos o consultas detalladas.' },
  { icon: 'clock', label: 'Horario', value: c.hours?.join(' · ') ?? null, href: null, note: 'Atención presencial con cita previa.' },
];
---

<ul role="list" class="channels">
  {channels.map((ch, i) => (
    <li class="channel card" data-reveal style={`--reveal-delay:${i * 60}ms`}>
      <span class="ch-icon"><Icon name={ch.icon} size={22} /></span>
      <h3 class="ch-label">{ch.label}</h3>
      <p class="ch-value">
        {ch.value && ch.href ? (
          <a href={ch.href} target={ch.external ? '_blank' : undefined} rel={ch.external ? 'noopener' : undefined}>{ch.value}</a>
        ) : (
          <Pending value={ch.value} what={ch.label} />
        )}
      </p>
      <p class="ch-note">{ch.note}</p>
    </li>
  ))}
</ul>

<style>
  .channels { display: grid; gap: 1rem; list-style: none; padding: 0; }
  @media (min-width: 640px) { .channels { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .channels { grid-template-columns: repeat(4, 1fr); } }
  .channel { display: grid; gap: 0.5rem; align-content: start; padding: 1.75rem; }
  .channel:hover { border-color: rgba(200, 164, 93, 0.45); }
  .ch-icon {
    display: grid; place-items: center;
    width: 46px; height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(200, 164, 93, 0.4);
    color: var(--gold);
    margin-bottom: 0.75rem;
  }
  .ch-label {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .ch-value { font-family: var(--font-serif); font-size: 1.45rem; line-height: 1.3; }
  .ch-value a { border-bottom: 1px solid rgba(200, 164, 93, 0.5); transition: color var(--dur) var(--ease); }
  .ch-value a:hover { color: var(--gold-light); }
  .ch-value :global(.pending) { font-size: 0.95rem; }
  .ch-note { font-size: var(--fs-sm); color: var(--text-muted); }
</style>
